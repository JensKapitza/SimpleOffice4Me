# SimpleOffice4Me system package defaults.
# This file is preserved as a package configuration file during upgrades.
SIMPLEOFFICE_HOST=127.0.0.1
SIMPLEOFFICE_PORT=8080
SIMPLEOFFICE_WSGI_THREADS=4
SIMPLEOFFICE_WSGI_CHANNEL_TIMEOUT=120
SIMPLEOFFICE_TRUSTED_PROXY_HOPS=0
SIMPLEOFFICE_BACKGROUND_INDEX=1
SIMPLEOFFICE_OSM_INDEX=1
SIMPLEOFFICE_DATALOGGER=1
