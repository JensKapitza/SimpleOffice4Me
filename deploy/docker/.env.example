# Bind the normal web container only to localhost when a reverse proxy is used.
SIMPLEOFFICE_BIND_ADDRESS=127.0.0.1
SIMPLEOFFICE_HTTP_PORT=8080

# Set to 1 only when exactly one trusted reverse proxy (Caddy/nginx/Traefik)
# is directly in front of SimpleOffice4Me.
SIMPLEOFFICE_TRUSTED_PROXY_HOPS=0

# Generate long independent random tokens locally. Do not commit real values.
# The federation token authenticates the federation transport only.
SIMPLEOFFICE_FEDERATION_TOKEN=
# Set this only when another instance may use the Resource Commander API.
# Keep it different from SIMPLEOFFICE_FEDERATION_TOKEN.
SIMPLEOFFICE_RESOURCE_COMMANDER_TOKEN=
SIMPLEOFFICE_FEDERATION_PEER_ID=