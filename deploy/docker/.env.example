# Bind the normal web container only to localhost when a reverse proxy is used.
SIMPLEOFFICE_BIND_ADDRESS=127.0.0.1
SIMPLEOFFICE_HTTP_PORT=8080

# Set to 1 only when exactly one trusted reverse proxy (Caddy/nginx/Traefik)
# is directly in front of SimpleOffice4Me.
SIMPLEOFFICE_TRUSTED_PROXY_HOPS=0

# Optional central privacy-preserving error relay. This is independent from
# federation and requires no GitHub token on the normal SimpleOffice instance.
# Example after publishing your relay through HTTPS:
# SIMPLEOFFICE_ERROR_REPORT_URL=https://errors.example.org/api/error-reports/v1/reports
SIMPLEOFFICE_ERROR_REPORT_URL=
SIMPLEOFFICE_VERSION=

# Settings used by deploy/docker/compose.error-relay.yaml.
# Keep the relay bound to localhost when a TLS reverse proxy is in front of it.
SIMPLEOFFICE_ERROR_RELAY_BIND_ADDRESS=127.0.0.1
SIMPLEOFFICE_ERROR_RELAY_PORT=8090
SIMPLEOFFICE_GITHUB_ERROR_REPOSITORY=JensKapitza/SimpleOffice4Me
SIMPLEOFFICE_GITHUB_ERROR_LABEL=
# Put the real token in deploy/docker/secrets/github-error-token. The entire
# secrets directory is ignored by Git and the token is never stored here.

# Generate long independent random tokens locally. Do not commit real values.
# The federation token authenticates the federation transport only.
SIMPLEOFFICE_FEDERATION_TOKEN=
# Token accepted by this instance for inbound Resource Commander requests.
# Keep it different from SIMPLEOFFICE_FEDERATION_TOKEN.
SIMPLEOFFICE_RESOURCE_COMMANDER_TOKEN=
# Outbound Commander credentials are per peer and never reuse the SOFP token.
# Example: {"backup-01":"remote-command-token","office":"another-token"}
SIMPLEOFFICE_RESOURCE_COMMANDER_PEER_TOKENS={}
# Alternatively set SIMPLEOFFICE_RESOURCE_COMMANDER_TOKEN_<PEER_ID> for one peer.
SIMPLEOFFICE_FEDERATION_PEER_ID=
