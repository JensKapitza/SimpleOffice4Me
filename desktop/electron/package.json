{
  "name": "simpleoffice4me-desktop",
  "version": "2.0.0",
  "private": true,
  "description": "Electron desktop wrapper for SimpleOffice4Me",
  "homepage": "https://github.com/JensKapitza/SimpleOffice4Me",
  "author": {
    "name": "Jens Kapitza",
    "email": "j.kapitza@schwarze-allianz.de"
  },
  "engines": {
    "node": ">=24"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "sync:version": "python ../python-setup/sync_project_version.py",
    "build:backend": "python ../python-setup/build_backend.py",
    "pack": "npm run sync:version && npm run build:backend && electron-builder --dir",
    "dist": "npm run sync:version && npm run build:backend && electron-builder"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "de.simpleoffice4me.desktop",
    "productName": "SimpleOffice4Me",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "loading.html",
      "build-config.json"
    ],
    "extraResources": [
      {
        "from": "../python-setup/dist",
        "to": "backend",
        "filter": ["**/*"]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": ["nsis", "portable"]
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Office",
      "maintainer": "Jens Kapitza <j.kapitza@schwarze-allianz.de>",
      "synopsis": "SimpleOffice4Me desktop application"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.productivity"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
